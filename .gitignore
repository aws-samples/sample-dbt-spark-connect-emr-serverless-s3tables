# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!*.tfvars.example
# .terraform.lock.hcl IS committed (pins provider versions + hashes) — Terraform best practice
override.tf
override.tf.json

# Generated by terraform apply (single source of truth for the runner)
generated/

# Python / uv
.venv/
__pycache__/
*.pyc
# runner/uv.lock IS committed for reproducible dbt/pyspark installs (must match EMR Spark version)
.env

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml
logs/

# OS
.DS_Store

# Blog draft — not part of the published sample
blog/

# Stray archives
Archive.zip
