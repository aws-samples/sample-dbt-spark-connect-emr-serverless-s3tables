# Optional overrides for local runs. The runner reads generated/emr_config.json
# by default, so you normally do not need to set anything here.

# Point at a specific config file (default: ../generated/emr_config.json)
# EMR_CONFIG_FILE=../generated/emr_config.json

# Override the dbt project / profiles directories.
# DBT_PROJECT_DIR=../dbt
# DBT_PROFILES_DIR=../dbt

# AWS credentials/region are taken from your standard AWS config (profile/SSO/env).
# AWS_PROFILE=my-profile
# AWS_REGION=us-east-1
